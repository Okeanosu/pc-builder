{
  "name": "pc-builder",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @pc/api --filter @pc/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "pnpm -r test",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "db:migrate": "pnpm --filter @pc/api db:migrate",
    "db:seed": "pnpm --filter @pc/api db:seed",
    "graph": "pnpm --filter @pc/graph build-graph",
    "graph:check": "pnpm --filter @pc/graph check",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm graph:check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "typescript": "~5.9.3",
    "@playwright/test": "~1.64.0"
  }
}
