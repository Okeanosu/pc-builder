# Copy to terraform.tfvars (gitignored) and fill in. Nothing in this file is secret: secrets go to Parameter Store
# through scripts/secrets.sh, never through Terraform.

# Account ID of the dedicated PERSONAL AWS account (top-right menu of the console). Terraform refuses any other.
aws_account_id = "123456789012"
aws_profile    = "pcbuilder"
region         = "ap-southeast-1"

alert_email        = "you@example.com"
monthly_budget_usd = 100

# Optional own domain. Leave empty to use the CloudFront address (https://d123abc.cloudfront.net).
# custom_domain                 = "shop.example.com"
# custom_domain_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/..."

# Raise to 1024 / 2048 if pages or the configuration engine feel slow (about +18 USD/month).
# task_cpu    = 512
# task_memory = 1024

# github_repository = "yamadaOliva/pc-builder"

# Shown to customers on the VietQR payment screen
