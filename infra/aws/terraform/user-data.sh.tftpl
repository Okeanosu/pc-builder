#!/bin/bash
# First-boot setup of the PC Builder host (Amazon Linux 2023, arm64), run once by cloud-init.
# Application files and secrets are NOT delivered here: the pcbuilder-deploy SSM document writes the files on every
# deploy, and deploy.sh reads the secrets from Parameter Store. Log: /var/log/cloud-init-output.log
set -euxo pipefail

# Follow the newest AL2023 release so security fixes keep arriving, and install them daily.
echo latest > /etc/dnf/vars/releasever
for attempt in 1 2 3 4 5; do dnf -y upgrade && break || sleep 15; done
dnf -y install docker dnf-automatic
sed -i -e 's/^upgrade_type *=.*/upgrade_type = security/' -e 's/^apply_updates *=.*/apply_updates = yes/' \
  /etc/dnf/automatic.conf
systemctl enable --now dnf-automatic.timer

# Docker with size-capped logs, so a noisy container cannot fill the disk.
install -d -m 0755 /etc/docker
cat > /etc/docker/daemon.json <<'JSON'
{
  "log-driver": "json-file",
  "log-opts": { "max-size": "10m", "max-file": "5" },
  "live-restore": true
}
JSON
systemctl enable --now docker

# Docker Compose is not packaged for AL2023: install a pinned release and check its SHA-256.
curl -fsSL --retry 5 -o /tmp/docker-compose \
  "https://github.com/docker/compose/releases/download/${compose_version}/docker-compose-linux-aarch64"
echo "${compose_sha256}  /tmp/docker-compose" | sha256sum -c -
install -D -m 0755 /tmp/docker-compose /usr/local/lib/docker/cli-plugins/docker-compose
rm -f /tmp/docker-compose
docker compose version

# 2 GiB swap: headroom for Postgres, the API and Next.js on a 2 GiB machine.
if [ ! -f /swapfile ]; then
  dd if=/dev/zero of=/swapfile bs=1M count=2048
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile none swap defaults 0 0' >> /etc/fstab
fi

# Root-only home of the stack. The deploy document fills it.
install -d -m 0700 -o root -g root /opt/pcbuilder /opt/pcbuilder/bin

# Database dump to S3 twice a day (07:30 and 19:30 Vietnam time). The alarm fires if a day passes without one.
cat > /etc/systemd/system/pcbuilder-backup.service <<'UNIT'
[Unit]
Description=Dump the PC Builder database to S3
After=docker.service
Requires=docker.service
ConditionPathExists=/opt/pcbuilder/current-tag

[Service]
Type=oneshot
ExecStart=/opt/pcbuilder/bin/backup.sh
UNIT

cat > /etc/systemd/system/pcbuilder-backup.timer <<'UNIT'
[Unit]
Description=Dump the PC Builder database twice a day

[Timer]
OnCalendar=*-*-* 00,12:30:00 UTC
RandomizedDelaySec=300
Persistent=true

[Install]
WantedBy=timers.target
UNIT

systemctl daemon-reload
systemctl enable --now pcbuilder-backup.timer
