# Production Caddyfile for the AWS host. Routing is the same as infra/Caddyfile; this copy adds browser security
# headers that only make sense on a real domain (HSTS would stick to "localhost" in the local demo).
{$DOMAIN} {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}

	@api path /api/*
	handle @api {
		# Compress JSON only. Compressing text/event-stream makes the encoder buffer the chat SSE stream,
		# so tokens would arrive in bursts instead of as they are generated.
		encode zstd gzip {
			match {
				header Content-Type application/json*
			}
		}
		reverse_proxy api:4000 {
			# SSE (/api/chat/...) must stream without buffering
			flush_interval -1
		}
	}

	handle {
		encode zstd gzip
		reverse_proxy web:3000
	}
}
