# Copy to infra/.env.prod and fill in. Never commit the real file.
# Every <placeholder> must be replaced. Generate each secret separately with: openssl rand -hex 32
# The API refuses to start in production when JWT_ACCESS_SECRET, JWT_REFRESH_SECRET or SEPAY_API_KEY is shorter
# than 32 characters or starts with "dev-"/"change-me", or when VIETQR_ACCOUNT_NO is still 0000000000.

# Public domain (A record pointing to the VPS). Use "localhost" for a local demo.
DOMAIN=shop.example.com
# Only for a local demo on non-standard ports, e.g. ":8443" (leave empty on a VPS)
PUBLIC_PORT_SUFFIX=
HTTP_PORT=80
HTTPS_PORT=443

POSTGRES_USER=pc
# openssl rand -hex 16
POSTGRES_PASSWORD=<postgres-password>
POSTGRES_DB=pcbuilder

# openssl rand -hex 32 (two different values)
JWT_ACCESS_SECRET=<openssl-rand-hex-32>
JWT_REFRESH_SECRET=<another-openssl-rand-hex-32>
ASSEMBLY_FEE=200000
ORDER_HOLD_MINUTES=15

# Empty key => chatbot runs in rule-based fallback mode. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_TIMEOUT_MS=20000

# The bank account that receives VietQR transfers
VIETQR_BANK_BIN=970422
VIETQR_ACCOUNT_NO=<bank-account-number>
VIETQR_ACCOUNT_NAME=PC BUILDER STORE
# openssl rand -hex 32; the same value goes into the SePay webhook (Authorization: Apikey <value>)
SEPAY_API_KEY=<openssl-rand-hex-32>

# Only read by the one-off seed command (docs/deploy.md §4). Prefer passing it with `exec -e` instead of storing it.
# SEED_ADMIN_PASSWORD=<at-least-12-characters>
# SEED_DEMO_USERS=1   # also create the staff/customer demo accounts (published passwords; demo machines only)

# Build-time only: set to 1 to expose /design
NEXT_PUBLIC_SHOW_DESIGN=
