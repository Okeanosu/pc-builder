    {
      "id": "G01",
      "category": "gaming",
      "note": "plain budget + purpose",
      "prompt": "Mình chơi game, ngân sách 25 triệu",
      "expect": { "tool": "recommend_builds", "purpose": "gaming", "budget": 25000000, "builds": true }
