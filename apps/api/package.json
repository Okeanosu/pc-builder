{
  "name": "@pc/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "start": "node --import tsx src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/*.int.test.ts'",
    "test:int": "vitest run int.test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=../../.env src/db/migrate.ts",
    "db:seed": "tsx --env-file=../../.env src/db/seed/index.ts",
    "eval:ai": "tsx --env-file=../../.env eval/run-eval.ts"
  },
  "dependencies": {
    "@google/genai": "2.32.0",
    "@pc/engine": "workspace:*",
    "@pc/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dejavu-fonts-ttf": "^2.37.3",
    "drizzle-orm": "^0.45.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.0",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^5.1.5",
    "pdfkit": "^0.17.0",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "postgres": "^3.4.7",
    "tsx": "^4.20.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/pdfkit": "^0.17.0",
    "@types/supertest": "^6.0.3",
    "autocannon": "^8.0.0",
    "drizzle-kit": "^0.31.0",
    "supertest": "^7.1.4",
    "typescript": "~5.9.3",
    "vitest": "~5.0.5"
  }
}
