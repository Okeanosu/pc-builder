# --- Infra (docker compose dev ports) ---
DATABASE_URL=postgres://pc:pc@localhost:5433/pcbuilder
DATABASE_URL_TEST=postgres://pc:pc@localhost:5433/pcbuilder_test
REDIS_URL=redis://localhost:6380/0
REDIS_URL_TEST=redis://localhost:6380/1

# --- API ---
PORT=4000
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000
# Development values only: with NODE_ENV=production the API refuses secrets that start with dev-/change-me
# or are shorter than 32 characters (see infra/.env.prod.example).
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
# Charged on assembled-build orders; the web reads it from GET /api/cart (assemblyFee), not from its own env.
ASSEMBLY_FEE=200000
ORDER_HOLD_MINUTES=15

# --- Google Gemini (free tier key: https://aistudio.google.com/apikey) ---
# Empty key => chatbot runs in fallback (rule-based) mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_TIMEOUT_MS=20000

# --- VietQR / SePay ---
VIETQR_BANK_BIN=970422
VIETQR_ACCOUNT_NO=0000000000
VIETQR_ACCOUNT_NAME=PC BUILDER STORE
SEPAY_API_KEY=change-me-sepay

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api
